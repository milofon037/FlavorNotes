<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="010-create-user-favorite-recipes" author="flavornotes">
        <createTable tableName="user_favorite_recipes">
            <column name="user_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="recipe_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="favorited_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        
        <addPrimaryKey tableName="user_favorite_recipes" columnNames="user_id, recipe_id"/>
        
        <addForeignKeyConstraint
            baseTableName="user_favorite_recipes"
            baseColumnNames="user_id"
            constraintName="fk_user_favorite_recipes_user_id"
            referencedTableName="users"
            referencedColumnNames="user_id"
            onDelete="CASCADE"/>
            
        <addForeignKeyConstraint
            baseTableName="user_favorite_recipes"
            baseColumnNames="recipe_id"
            constraintName="fk_user_favorite_recipes_recipe_id"
            referencedTableName="recipes"
            referencedColumnNames="recipe_id"
            onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>

